# SpotiDash configuration
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env

# --- Spotify API credentials (required) ---
# Create an app at https://developer.spotify.com/dashboard to get these.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# OAuth callback URL. Must EXACTLY match the Redirect URI registered
# in your Spotify app settings. Spotify no longer accepts "localhost" —
# use the loopback IP 127.0.0.1, and open the app at http://127.0.0.1:8050.
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8050/callback

# --- Flask (optional) ---
# Session signing key. Leave blank for local dev (a random key is generated
# per process). Set it in production so login sessions survive restarts.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
